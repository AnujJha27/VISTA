OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openrouter/free

# Optional for cluster-hosted OpenAI-compatible local LLMs:
VISTA_OPENAI_BASE_URL=http://cluster-node:8000/v1
VISTA_OPENAI_MODEL=local-lean-coder
# VISTA_OPENAI_API_KEY=replace-if-required

# Maestro cluster presets are also available without env:
# ./vista demo physics-toy --llm maestro
# ./vista demo physics-toy --llm piano
# ./vista demo physics-toy --llm sitar
# ./vista demo physics-toy --llm violin
